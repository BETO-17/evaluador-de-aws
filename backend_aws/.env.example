# ==========================================================
# VARIABLES DE ENTORNO — CLOUD DIAGNOSTIX AWS BACKEND
# Referencia: context_backend/00_README_ARQUITECTURA_BACKEND.md
# ==========================================================

# 1. Configuración del Servidor FastAPI
APP_NAME="Cloud Diagnostix AWS Backend"
APP_VERSION="1.0.0"
HOST="0.0.0.0"
PORT=8080
DEBUG=True

# 2. Orígenes permitidos por CORS (Frontend Vite en 5173 / 3000)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,*"

# 3. Base de Datos (SQLite local por defecto para arranque inmediato o PostgreSQL 16)
DATABASE_URL="sqlite:///./clouddiagnostix.db"
# Para producción / PostgreSQL 16 descomenta la siguiente línea:
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/clouddiagnostix_db"

# 4. Seguridad JWT & TOTP (RFC 6238 — Ventana de 30s, 6 dígitos, SHA1)
JWT_SECRET_KEY="clouddiagnostix_aws_super_secret_key_256_bits_2026_rea_engine"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEFAULT_TOTP_SECRET="JBSWY3DPEHPK3PXP"

# 5. Motor de IA para Evaluación REA (Google Gemini API)
# Si GEMINI_API_KEY está vacía, el Motor Heurístico Determinista responde sin fallar.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
CLAUDE_API_KEY=""
CLAUDE_MODEL="claude-sonnet-5"

# 6. GitHub Token opcional para elevar límite de rate-limit al auditar repositorios
GITHUB_API_TOKEN=""

# 7. Recuperación de contraseña por correo SMTP
FRONTEND_PUBLIC_URL="http://localhost:5173"
PASSWORD_RESET_TOKEN_MINUTES=15
EMAIL_CODE_EXPIRATION_MINUTES=10
EMAIL_CODE_MAX_ATTEMPTS=5
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USE_SSL=False
SMTP_USE_TLS=True
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM=""

